DATABASE_URL_MD=postgresql://ユーザー名:パスワード@db:5432/rb2db_md
DATABASE_URL_FOUR=postgresql://ユーザー名:パスワード@db:5432/rb2db_four
POSTGRES_USER=ユーザー名
POSTGRES_PASSWORD=パスワード

# ─── MCP サーバー用 read-only 接続 ────────────────────────────────
# MCP サーバー（app/mcp）は read-only 専用ロール rb2db_readonly で接続する。
# ロールは docker/setup_readonly_role.sql で作成し、パスワードを設定しておくこと。
# 書き込み可能な上記 DATABASE_URL_* とは別のロールを使う。
DATABASE_URL_MD_RO=postgresql://rb2db_readonly:readonlyパスワード@db:5432/rb2db_md
DATABASE_URL_FOUR_RO=postgresql://rb2db_readonly:readonlyパスワード@db:5432/rb2db_four

# MCP が「大量の生データはスクリプトから REST API で」と AI に案内するときの URL。
# 本番では公開URLを、ローカル開発では手元の API（例: http://localhost:8000）を書く。
# 省略すると、AI は API の URL をユーザーに確認するよう案内される。
PUBLIC_API_URL=https://api.example.com

# ─── ログ設定 ─────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL (デフォルト: INFO)
# LOG_FORMAT: simple (開発環境向け人間が読める形式) / json (本番環境向けJSON形式)
#
# 例：
#   LOG_LEVEL=DEBUG LOG_FORMAT=json python -m uvicorn app.main:app
LOG_LEVEL=INFO
LOG_FORMAT=simple

# ─── Cloudflare Tunnel ────────────────────────────────────────────
# cloudflared コンテナ用のトンネルトークン。
# Cloudflare ダッシュボードでトンネルを作成すると発行される。
CF_TUNNEL_TOKEN=eyJhIjoixxxxxxxx

# ───── Slack更新通知用 ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
GEMINI_API_KEY=your_gemini_api_key
