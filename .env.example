DATABASE_URL_MD=postgresql://ユーザー名:パスワード@db:5432/rb2db_md
DATABASE_URL_FOUR=postgresql://ユーザー名:パスワード@db:5432/rb2db_four
POSTGRES_USER=ユーザー名
POSTGRES_PASSWORD=パスワード

# ─── ログ設定 ─────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL (デフォルト: INFO)
# LOG_FORMAT: simple (開発環境向け人間が読める形式) / json (本番環境向けJSON形式)
#
# 例：
#   LOG_LEVEL=DEBUG LOG_FORMAT=json python -m uvicorn app.main:app
LOG_LEVEL=INFO
LOG_FORMAT=simple
