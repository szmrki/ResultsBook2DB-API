# Git管理ファイル（コンテナに不要）
.git
.gitignore

# Pythonのキャッシュファイル（コンテナ内で再生成される）
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 仮想環境（コンテナ内では uv が管理するため不要）
.venv/
venv/

# 環境変数ファイル（機密情報のため絶対に含めない）
.env
.env.*

# エディタ・OS固有ファイル
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ドキュメント・ログ（実行に不要）
*.md
*.log
logs/

# テストファイル（本番イメージに不要）
tests/